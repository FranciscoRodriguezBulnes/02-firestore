// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección urls
    match /urls/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.user;
    }

    // Colección users
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}